# Copy to .env and adjust before: docker compose up -d --build

# --- Public HTTPS (Traefik terminates TLS; nginx in web serves SPA + /api proxy) ---
CONSOLE_HOST=console.ovncr.vn
DOWNLOAD_HOST=download.ovncr.vn
PUBLIC_BASE_URL=https://console.ovncr.vn
# Leave empty for same-origin API via nginx (recommended).
VITE_API_URL=

# --- Let's Encrypt DNS-01 via Cloudflare (Traefik) ---
ACME_EMAIL=you@example.com
CLOUDFLARE_DNS_API_TOKEN=your_cloudflare_dns_api_token
# Docker network for shared-edge worker stacks (default matches compose project "t01_headscale_management")
SHARED_EDGE_DOCKER_NETWORK=t01_headscale_management_app

# --- Django ---
DJANGO_SECRET_KEY=change-me-use-openssl-rand-hex-32
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,web,console.ovncr.vn,download.ovncr.vn
APP_VERSION=0.1.0

SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# --- PostgreSQL ---
POSTGRES_DB=headscale_mgmt
POSTGRES_USER=headscale
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- CORS (must include the public HTTPS UI origin) ---
CORS_ALLOWED_ORIGINS=https://console.ovncr.vn

# --- Initial admin (created on first backend start) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# --- Local dev without Traefik (optional) ---
# Create docker-compose.override.yml:
#   services:
#     web:
#       ports:
#         - "8080:80"
