# Copy to .env and adjust before: docker compose up -d --build

# --- Web ---
# Change if 8080 is already in use on the host
WEB_PORT=8080
# Leave empty for same-origin API via nginx (recommended).
VITE_API_URL=

# --- Django ---
DJANGO_SECRET_KEY=change-me-use-openssl-rand-hex-32
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,web
APP_VERSION=0.1.0

# Session cookies over plain HTTP in local Docker (set true behind HTTPS).
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# --- PostgreSQL ---
POSTGRES_DB=headscale_mgmt
POSTGRES_USER=headscale
POSTGRES_PASSWORD=headscale
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- CORS (include your public UI URL; match WEB_PORT) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Initial admin (created on first backend start) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com
